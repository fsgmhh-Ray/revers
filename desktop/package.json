{
  "name": "cineflowing-reverse-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "reverse.cineflowing.com 桌面端：本机 IP 解析 + 内置 yt-dlp/FFmpeg",
  "author": "Cineflowing",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/run-electron.js .",
    "binaries": "node scripts/fetch-binaries.js",
    "icon": "node scripts/make-icon.js",
    "check": "node --check main.js && node --check ipc.js && node --check config.js && node --check preload.js && node --check smoke.test.js && node --check parse.test.js && node --check storyboard.test.js",
    "smoke": "node scripts/run-electron.js smoke.test.js",
    "parse": "node scripts/run-electron.js parse.test.js",
    "storyboard": "node scripts/run-electron.js storyboard.test.js",
    "selfcheck": "node scripts/run-electron.js . --self-check",
    "probe:packaged": "node scripts/run-probe.js",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "ci": "npm install && npm run binaries && npm run icon && npm run check && npm run smoke && npm run storyboard && npm run dist && npm run probe:packaged"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cineflowing.reverse",
    "productName": "Cineflowing Reverse",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "ipc.js",
      "config.js",
      "preload.js",
      "bin/**"
    ],
    "asar": true,
    "asarUnpack": [
      "bin/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
